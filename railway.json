{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    {
      "name": "stock-watch-api",
      "source": "services/stock-watch/backend",
      "domain": "stock-watch.up.railway.app"
    }
  ]
}
